      "scopes": [
        "gateway/invoke"
      ],
      "vendor": "CustomOauth2"
    }
  ],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "workshop-gateway",
      "protocolType": "None",
      "description": "Gateway for workshop-gateway",
      "targets": [
        {
          "name": "data-lookup",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-west-2:115805780657:function:workshop-data-lookup",
            "toolSchemaFile": "./tool_specs/data_lookup.json"
          }
        },
        {
          "name": "policy-retrieval",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
