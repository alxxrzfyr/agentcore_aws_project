  "runtimes": [
    {
      "name": "CustomerAssistantAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/CustomerAssistantAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "envVars": [
        {
          "name": "MEMORY_ID",
          "value": "AgentCoreProject_CustomerAssistantMemory-9UwJ6x9YN7"
        },
        {
          "name": "GATEWAY_URL",
          "value": "https://agentcoreproject-workshop-gateway-mzqqvf7sgc.gateway.bedrock-agentcore.us-west-2.amazonaws.com"
        },
        {
          "name": "GATEWAY_CLIENT_ID",
          "value": "5ksdu89p2e6ea6h2ts62ugsck6"
        },
        {
          "name": "GATEWAY_CLIENT_SECRET",
          "value": "<REDACTED>"
        },
        {
          "name": "GATEWAY_TOKEN_ENDPOINT",
          "value": "https://workshop-gw-9199.auth.us-west-2.amazoncognito.com/oauth2/token"
        },
        {
          "name": "GATEWAY_SCOPE",
          "value": "gateway/invoke"
        }
      ],
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "CustomerAssistantMemory",
      "eventExpiryDuration": 7,
      "strategies": [
        {
          "type": "USER_PREFERENCE",
