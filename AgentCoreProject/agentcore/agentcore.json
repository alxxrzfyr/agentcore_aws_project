      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-west-2.amazonaws.com/us-west-2_4RJSTexeJ/.well-known/openid-configuration",
          "allowedClients": [
            "5ksdu89p2e6ea6h2ts62ugsck6"
