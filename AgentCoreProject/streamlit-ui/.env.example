# Streamlit UI configuration
# Copy to .env and export before running: streamlit run streamlit_app.py

# AWS region where the agent and Cognito pool are deployed
AWS_REGION="us-west-2"

# Cognito User Pool ID (e.g. us-west-2_XXXXXXXXX)
COGNITO_USER_POOL_ID=""

# Cognito app client ID for the UI (USER_PASSWORD_AUTH flow)
COGNITO_UI_CLIENT_ID=""

# ARN of the deployed AgentCore Runtime agent
AGENT_RUNTIME_ARN=""
